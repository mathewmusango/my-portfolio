# Deployment values for scripts/bootstrap-aws.sh — copy to .env (gitignored)
# and fill in. Values live here, never in the repo code.
#
# PROJECT   — prefixes resource names (role, buckets, lock table, policies).
#             MUST be globally unique per deployment: IAM roles/policies and
#             S3 bucket names are global (region-independent). For the same
#             site in another region, suffix it (e.g. my-portfolio-eu).
# AWS_REGION— region for the state bucket + lock table (and the stack).
# REPOS     — GitHub repos allowed to assume the OIDC role, space-separated
#             (e.g. mathewmusango/my-portfolio, anotherorg/another-repo).

PROJECT=
AWS_REGION=
REPOS=["mathewmusango/my-portfolio"]
